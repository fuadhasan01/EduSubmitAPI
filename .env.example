# PostgreSQL
POSTGRES_DB=edusubmit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@edusubmit.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# Application database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=edusubmit;Username=postgres;Password=your_postgres_password

# JWT
JwtSettings__SecretKey=your-jwt-secret-key-at-least-32-characters
JwtSettings__Issuer=EduSubmit.Api
JwtSettings__Audience=EduSubmit.Client
JwtSettings__ExpiryMinutes=60