    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EduSubmit.Application\EduSubmit.Application.csproj" />
    <ProjectReference Include="..\EduSubmit.Infrastructure\EduSubmit.Infrastructure.csproj" />
  </ItemGroup>

